{
  "models": {
    "planner": {
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "attempts": [
      {
        "model": "gpt-5.6-luna",
        "reasoningEffort": "medium"
      },
      {
        "model": "gpt-5.6-luna",
        "reasoningEffort": "medium"
      },
      {
        "model": "gpt-5.6-terra",
        "reasoningEffort": "high"
      },
      {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high"
      }
    ],
    "highRiskAttempts": [
      {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high"
      },
      {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high"
      }
    ],
    "reviewer": {
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high"
    }
  },
  "execution": {
    "sandbox": "workspace-write",
    "allowDangerFullAccess": false,
    "maxHours": 12,
    "maxCodexCalls": 100,
    "codexTimeoutMinutes": 90,
    "verificationTimeoutMinutes": 30,
    "checkpointEvery": 3,
    "maxCheckpointReplans": 2,
    "requireCleanTree": true,
    "autoCommit": true
  },
  "verification": {
    "profiles": {
      "basic": [
        "git diff --check"
      ]
    }
  }
}
