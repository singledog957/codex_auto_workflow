{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "gaps_found"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "objective",
          "acceptanceCriteria",
          "verificationProfile",
          "risk",
          "maxFiles"
        ],
        "properties": {
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "verificationProfile": {
            "type": "string"
          },
          "risk": { "type": "string", "enum": ["normal", "high"] },
          "maxFiles": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    }
  }
}
