{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "tasks"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["work_remaining", "already_complete", "blocked"]
    },
    "summary": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "taskType",
          "maxFiles",
          "title",
          "objective",
          "acceptanceCriteria",
          "dependencies",
          "verificationProfile",
          "risk"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
          "taskType": {
            "type": "string",
            "enum": ["implementation", "checkpoint"]
          },
          "maxFiles": { "type": "integer", "minimum": 1, "maximum": 20 },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^T[0-9]{3,}$" }
          },
          "verificationProfile": {
            "type": "string"
          },
          "risk": { "type": "string", "enum": ["normal", "high"] }
        }
      }
    }
  }
}
